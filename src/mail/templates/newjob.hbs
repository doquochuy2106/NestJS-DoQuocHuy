<html>
  <head>
    <title>Job Notification</title>
    <meta charset='UTF-8' />
  </head>

  <body
    style='margin: 0; padding: 0; background-color: #f5f5f5; font-family: Arial, sans-serif;'
  >
    <table border='0' cellpadding='0' cellspacing='0' width='100%'>
      <tr>
        <td align='center' style='padding: 20px 0;'>
          <table
            border='0'
            cellpadding='0'
            cellspacing='0'
            width='600'
            style='background-color: #ffffff; border-radius: 5px; padding: 20px;'
          >

            <tr>
              <td>
                <table border='0' cellpadding='0' cellspacing='0' width='100%'>
                  <tr>
                    <td
                      align='left'
                      style='font-weight: bold; font-size: 20px;'
                    >IT Việc</td>
                    <td
                      align='right'
                      style='color: #666; font-style: italic;'
                    >Ít nhưng mà chất</td>
                  </tr>
                </table>
                <hr
                  style='border: none; border-top: 1px solid #eee; margin: 15px 0;'
                />
              </td>
            </tr>

            <tr>
              <td style='padding-bottom: 20px;'>
                <p style='margin: 0 0 10px 0;'>Hi
                  <strong>{{receiver}}</strong>,</p>
                <p style='margin: 0;'>One of these jobs may be your next one.
                  Find out today!</p>
              </td>
            </tr>

            <tr>
              <td>
                <table border='0' cellpadding='0' cellspacing='0' width='100%'>
                  {{#each jobs}}
                    <tr>
                      <td style='border-top: 1px dashed #ddd; padding: 15px 0;'>
                        <a
                          href='#'
                          style='color: #007bff; text-decoration: none; font-size: 18px; font-weight: bold; display: block;'
                        >
                          {{name}}
                        </a>
                        <div
                          style='margin-top: 5px; font-size: 14px; color: #333;'
                        >{{companyName}}</div>
                        <div
                          style='color: #e74c3c; font-weight: bold; margin-top: 5px;'
                        >{{salary}}</div>

                        <div style='margin-top: 10px;'>
                          {{#each skills}}
                            <span
                              style='background: #eee; padding: 3px 8px; border-radius: 3px; font-size: 12px; margin-right: 5px; color: #555; display: inline-block; margin-bottom: 5px;'
                            >
                              {{this}}
                            </span>
                          {{/each}}
                        </div>
                      </td>
                    </tr>
                  {{/each}}
                </table>
              </td>
            </tr>

            <tr>
              <td align='center' style='padding: 25px 0;'>
                <a
                  href='#'
                  style='background-color: #ea1e30; color: white; padding: 12px 0; text-decoration: none; border-radius: 5px; display: block; font-weight: bold; width: 100%; text-align: center;'
                >
                  Xem thêm job tại IT Việc
                </a>
              </td>
            </tr>

            <tr>
              <td style='padding-top: 10px; color: #777; font-size: 14px;'>
                Cheers,<br />
                <strong>The ITviec Team</strong>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>